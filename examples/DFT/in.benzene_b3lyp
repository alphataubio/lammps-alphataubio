# LAMMPS input script for benzene molecule with DFT (B3LYP hybrid functional)

# Initialize simulation
units           real
atom_style      full
boundary        f f f

# Create benzene molecule (C6H6)
region          box block -15.0 15.0 -15.0 15.0 -15.0 15.0
create_box      2 box

# Add atoms (benzene ring - planar hexagon)
# Carbon atoms
create_atoms    2 single  1.398  0.000  0.0
create_atoms    2 single  0.699  1.211  0.0
create_atoms    2 single -0.699  1.211  0.0
create_atoms    2 single -1.398  0.000  0.0
create_atoms    2 single -0.699 -1.211  0.0
create_atoms    2 single  0.699 -1.211  0.0

# Hydrogen atoms
create_atoms    1 single  2.487  0.000  0.0
create_atoms    1 single  1.244  2.153  0.0
create_atoms    1 single -1.244  2.153  0.0
create_atoms    1 single -2.487  0.000  0.0
create_atoms    1 single -1.244 -2.153  0.0
create_atoms    1 single  1.244 -2.153  0.0

# Set masses
mass            1 1.008   # Hydrogen
mass            2 12.011  # Carbon

# Set charges (nuclear charges)
set             type 1 charge 1.0
set             type 2 charge 6.0

# DFT pair style with B3LYP hybrid functional and def2-SVP basis
# B3LYP includes 20% exact exchange
pair_style      dft B3LYP def2-svp.C_H.json grid 75000 tol 1e-8 maxiter 150

# Pair coefficients: atom_type atom_type nuclear_charge vdw_radius
pair_coeff      1 1 1.0 1.20   # H-H
pair_coeff      1 2 1.0 1.20   # H-C (H parameters)
pair_coeff      2 2 6.0 1.70   # C-C

# Neighbor list
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Output settings
thermo_style    custom step pe ke etotal temp press vol
thermo          1
thermo_modify   norm no

# Dump trajectory with molecular information
dump            1 all custom 10 benzene_b3lyp.lammpstrj id type x y z
dump_modify     1 sort id

# Initial single point calculation
run             0

# Geometry optimization with tight convergence
min_style       cg
min_modify      dmax 0.01
minimize        1.0e-10 1.0e-12 5000 10000

# Write optimized structure
write_data      benzene_b3lyp_optimized.data

# Vibrational frequency calculation (via finite differences)
# Note: This is a simple approach - for accurate frequencies use specialized QM software
variable        dx equal 0.001
variable        natoms equal 12

# Compute forces at equilibrium
run             0

print           "========================================="
print           "Benzene optimization complete with B3LYP"
print           "Final energy: $(pe) kcal/mol"
print           "========================================="
