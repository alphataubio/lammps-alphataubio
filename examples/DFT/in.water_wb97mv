# LAMMPS input script for water molecule with DFT (wB97M-V functional)

# Initialize simulation
units           real
atom_style      full
boundary        f f f

# Create water molecule
region          box block -10.0 10.0 -10.0 10.0 -10.0 10.0
create_box      2 box

# Add atoms (water molecule)
create_atoms    2 single 0.0 0.0 0.0
create_atoms    1 single 0.7569 0.5858 0.0
create_atoms    1 single -0.7569 0.5858 0.0

# Set masses
mass            1 1.008   # Hydrogen
mass            2 15.999  # Oxygen

# Set charges (formal charges for initial guess)
set             type 1 charge 1.0
set             type 2 charge 8.0

# DFT pair style with wB97M-V functional and def2-TZVP basis
pair_style      dft wb97mv def2-tzvp.H_O.json grid 75000 tol 1e-8 dispersion D3BJ

# Pair coefficients: atom_type atom_type nuclear_charge vdw_radius
pair_coeff      1 1 1.0 1.20   # H-H
pair_coeff      1 2 1.0 1.20   # H-O (H parameters)
pair_coeff      2 2 8.0 1.52   # O-O

# Neighbor list
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Output
thermo_style    custom step pe ke etotal temp
thermo          1

# Dump trajectory
dump            1 all xyz 1 water_wb97mv.xyz
dump_modify     1 element H O

# Energy minimization
minimize        1.0e-10 1.0e-12 1000 10000

# NVE dynamics (short test run)
timestep        0.1
fix             1 all nve
run             100

# Final energy calculation
run             0
