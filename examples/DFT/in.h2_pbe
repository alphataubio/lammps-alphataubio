# H2 single-point energy with DFT(PBE) + def2-SVP
units           real
atom_style      atomic
boundary        f f f

# Box and atoms
region          box block -10 10 -10 10 -10 10
create_box      1 box
create_atoms    1 single -0.37 0.0 0.0
create_atoms    1 single  0.37 0.0 0.0
mass            1 1.00794

# --- DFT setup (LibXC/libint2) ---
# Basis JSON must include H shells in BSE JSON format
pair_style      dft PBE def2-svp.H.json grid 50000 tol 1e-9 maxiter 150
pair_coeff      1 1 1.0 1.20   # H: Z=1, vdW~1.2 Å

neighbor        2.0 bin
neigh_modify    delay 0 every 1

thermo_style    custom step pe etotal press
thermo          1

# Single-point
run             0
