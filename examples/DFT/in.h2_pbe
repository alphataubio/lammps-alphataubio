# H2 single-point energy with DFT(PBE) + def2-SVP
units           metal
atom_style      charge
boundary        f f f

# Box and atoms
region          box block -10 10 -10 10 -10 10
create_box      1 box
create_atoms    1 single -0.3705 0.0 0.0
create_atoms    1 single  0.3705 0.0 0.0
mass            1 1.00794

# --- DFT setup (LibXC/libint2) ---
# Basis JSON must include H shells in BSE JSON format
# pair_style      dft PBE def2-svp.H.json grid 50000 tol 1e-6 maxiter 150
pair_style      dft PBE  /Users/mitch/github/lammps-alphataubio/examples/DFT/aug-cc-pvtz.H.json &
  grid 50000 tol 1e-6 maxiter 150
pair_coeff      * *

neighbor        2.0 bin
neigh_modify    delay 0 every 1

thermo_style    custom step ke pe etotal press
thermo          1

# Single-point
run             0
