# Advanced LAMMPS input script for DFT package with LibXC
# This demonstrates GGA and meta-GGA functionals

# Initialize simulation
units          metal
atom_style     atomic
boundary       p p p

# Create a more complex system - binary alloy surface
lattice        fcc 3.615
region         substrate block 0 20 0 20 0 10
region         adsorbate block 8 12 8 12 10 12
create_box     3 substrate
create_atoms   1 region substrate
create_atoms   2 region adsorbate

# Add some impurities
set            type 1 type/fraction 2 0.1 12345

# Set masses
mass           1 63.546  # Cu
mass           2 107.868 # Ag  
mass           3 196.967 # Au

# Advanced DFT functional - PBE0 hybrid functional
# Note: Hybrid functionals are computationally expensive
#pair_style     libxc B3LYP 15.0 ngrid 200 spacing 0.005

# Use PBE GGA functional for production
pair_style     libxc GGA_X_PBE+GGA_C_PBE 15.0 ngrid 150 spacing 0.008

# Pair coefficients with element-specific parameters
# These parameters would need to be fitted to DFT calculations
pair_coeff     1 1 0.150 2.50 11.8 15.0  # Cu-Cu
pair_coeff     2 2 0.130 2.70 17.1 15.0  # Ag-Ag
pair_coeff     3 3 0.170 2.45 17.2 15.0  # Au-Au
pair_coeff     1 2 0.140 2.60 14.0 15.0  # Cu-Ag
pair_coeff     1 3 0.160 2.48 14.5 15.0  # Cu-Au
pair_coeff     2 3 0.150 2.58 17.15 15.0 # Ag-Au

# Neighbor list with larger cutoff for GGA
neighbor       2.5 bin
neigh_modify   delay 5 every 1 check yes

# Initial minimization
min_style      cg
minimize       1e-8 1e-10 5000 10000

# Compute electron density distribution
# (This would require additional compute styles to be implemented)
#compute        rho all property/atom rho
#compute        rho_ave all reduce ave c_rho

# Set up NPT simulation for surface relaxation
velocity       all create 300.0 873847 dist gaussian
fix            1 all npt temp 300.0 300.0 0.1 iso 0.0 0.0 1.0
timestep       0.001

# Output
thermo         100
thermo_style   custom step temp pe ke etotal press pxx pyy pzz vol
#thermo_modify  line multi

# Detailed trajectory with energies
dump           1 all custom 200 dft_gga_traj.lammpstrj id type x y z fx fy fz
dump_modify    1 sort id

# Compute radial distribution function
compute        rdf all rdf 100 1 1 1 2 1 3 2 2 2 3 3 3
fix            2 all ave/time 100 10 1000 c_rdf[*] file rdf.dat mode vector

# Run initial equilibration
run            5000

# Switch to NVT for production
unfix          1
fix            1 all nvt temp 300.0 300.0 0.1

# Production run
run            20000

# Calculate final properties
compute        pe_atom all pe/atom
compute        stress all stress/atom NULL
dump           2 all custom 1 final_state.dump id type x y z c_pe_atom c_stress[*]
run            0

print          "Advanced DFT simulation with GGA functional complete"
