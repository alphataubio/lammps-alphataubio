# Test input for H2 molecule with PBE functional
# This tests the DFT pair style implementation

# Basic setup
units real
atom_style atomic
dimension 3
boundary p p p

# Create box and atoms
region box block -10 10 -10 10 -10 10
create_box 2 box

# Create H2 molecule
create_atoms 1 single 0.0 0.0 -0.35
create_atoms 1 single 0.0 0.0  0.35

# Mass (H atoms)
mass 1 1.00794

# DFT pair style
# Format: pair_style dft <functional> <basis.json> [options]
# Functional: PBE (will be mapped to GGA_X_PBE+GGA_C_PBE)
# Basis: def2-svp for hydrogen
# Grid: 50000 points
# Tolerance: 1e-9
# Max iterations: 150
pair_style dft PBE def2-svp.H.json grid 50000 tol 1e-9 maxiter 150

# Pair coefficients
# Format: pair_coeff i j charge vdw_radius
pair_coeff 1 1 1.0 0.5  # H-H

# Neighbor list
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# Output
thermo 10
thermo_style custom step etotal pe ke temp

# Minimize to find equilibrium bond length
minimize 1e-8 1e-10 1000 10000

# Run short MD
velocity all create 300.0 12345
fix 1 all nve

timestep 0.1
run 100

# Print final configuration
write_data h2_dft_final.data
